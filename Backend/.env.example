# ==========================================
# Application Configuration
# ==========================================

# Secret key used for signing JWT authentication tokens. 
# You can generate a random string for this in production.
JWT_SECRET_KEY=super-secret-heisenbugs-key-change-in-prod

# Database connection string. 
# If left empty/commented, the app defaults to a local SQLite database (instance/app.db).
# DATABASE_URI=sqlite:///instance/app.db


# ==========================================
# External AI API Keys
# ==========================================

# Groq API Key
# Used for the LLM powering the personalized Chatbot and dynamic Quiz Generation.
# Get yours at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Bytez API Key
# Used for generating embeddings for the learning paths and resources.
# Get yours at: https://bytez.com/
BYTEZ_API_KEY=your_bytez_api_key_here
